{
 "about": "Shared cases for a watch job's read shapes (oe_connector/watch.py, the module doc). oe_connector's watch._shape_problem / watch._mismatch and OpenExecutive's registry.shape_mismatch are both tested against this file. A slot holds a value only when slot_oracle lists that exact JSON value for it (same type: true is never 1), so both sides test the structure, not the database. shapes: whether a read (its arguments, without tool) is sound; an unsound one leaves its job out. matches: whether arguments fit a sound read.",
 "slot_oracle": {
  "$company": ["Acme Ltd"],
  "$date": ["2026-11-10"],
  "$party": ["Sup A"],
  "$parties": [["Sup A", "Sup B"], ["Sup A"]],
  "$customers": [["Cust A"]],
  "$int": [50],
  "$bank_line": ["ACC-BTN-2026-00001"],
  "$mail_draft": ["ACC-PINV-2026-00001"],
  "$mail_file": ["f1a2b3c4d5"]
 },
 "shapes": [
  {"note": "the collections report", "read": {"report_name": "Accounts Receivable", "filters": {"company": "$company", "report_date": "$date", "ageing_based_on": "Due Date"}}, "valid": true},
  {"note": "payment checks, read 1", "read": {"doctype": "Purchase Invoice", "fields": ["name", "supplier"], "filters": {"company": "$company", "docstatus": ["<", 2], "outstanding_amount": [">", 0], "due_date": ["<=", "$date"]}}, "valid": true},
  {"note": "payment checks, read 2", "read": {"doctype": "Purchase Invoice", "filters": {"company": "$company", "docstatus": 1, "supplier": ["in", "$parties"], "posting_date": [">=", "$date"]}}, "valid": true},
  {"note": "a list slot as a top-level argument", "read": {"company": "$company", "customers": "$customers"}, "valid": true},
  {"note": "a literal list with no slot", "read": {"filters": {"status": ["in", "Overdue"]}}, "valid": true},
  {"note": "not in with a list slot", "read": {"filters": {"supplier": ["not in", "$parties"]}}, "valid": true},
  {"note": "a typo'd slot", "read": {"filters": {"company": "$Company"}}, "valid": false},
  {"note": "a typo'd slot in a list", "read": {"filters": {"due_date": ["<=", "$dates"]}}, "valid": false},
  {"note": "a slot after like", "read": {"filters": {"supplier": ["like", "$party"]}}, "valid": false},
  {"note": "a slot after not like", "read": {"filters": {"supplier": ["not like", "$party"]}}, "valid": false},
  {"note": "a single name after in, which Frappe splits on commas", "read": {"filters": {"supplier": ["in", "$party"]}}, "valid": false},
  {"note": "a list slot after =", "read": {"filters": {"supplier": ["=", "$parties"]}}, "valid": false},
  {"note": "a list slot on its own as a filter value", "read": {"filters": {"supplier": "$parties"}}, "valid": false},
  {"note": "a slot first", "read": {"filters": {"due_date": ["$date", "<="]}}, "valid": false},
  {"note": "a slot in a list of three", "read": {"filters": {"due_date": ["between", "$date", "$date"]}}, "valid": false},
  {"note": "a list inside a list", "read": {"filters": {"status": ["in", ["Overdue", "Unpaid"]]}}, "valid": false},
  {"note": "an object inside a list", "read": {"filters": {"status": ["=", {"a": 1}]}}, "valid": false},
  {"note": "a slot among the fields", "read": {"fields": ["name", "$party"]}, "valid": false},
  {"note": "a nested fields key follows the list rules, not the fields rule", "read": {"filters": {"fields": ["like", "$party"]}}, "valid": false},
  {"note": "a bank line slot as a top-level argument", "read": {"bank_transaction": "$bank_line"}, "valid": true},
  {"note": "a bank line slot after =", "read": {"filters": {"name": ["=", "$bank_line"]}}, "valid": true},
  {"note": "a bank line slot after in, which takes list slots only", "read": {"filters": {"name": ["in", "$bank_line"]}}, "valid": false},
  {"note": "invoice capture: the mail's attachment (only for read_attachment)", "tool": "read_attachment", "read": {"doctype": "Purchase Invoice", "name": "$mail_draft", "file": "$mail_file"}, "valid": true},
  {"note": "a mail file without its draft", "read": {"doctype": "Purchase Invoice", "name": "ACC-PINV-1", "file": "$mail_file"}, "valid": false},
  {"note": "a mail draft without its file", "read": {"doctype": "Purchase Invoice", "name": "$mail_draft"}, "valid": false},
  {"note": "a mail draft without a doctype", "read": {"name": "$mail_draft", "file": "$mail_file"}, "valid": false},
  {"note": "a mail draft of another doctype", "read": {"doctype": "Sales Invoice", "name": "$mail_draft"}, "valid": false},
  {"note": "a mail slot in a filter", "read": {"doctype": "Purchase Invoice", "filters": {"name": ["=", "$mail_draft"]}}, "valid": false},
  {"note": "a mail draft as the file", "read": {"doctype": "Purchase Invoice", "name": "$mail_draft", "file": "$mail_draft"}, "valid": false}
 ],
 "matches": [
  {"note": "read 1 as listed", "read": {"filters": {"company": "$company", "docstatus": ["<", 2], "outstanding_amount": [">", 0], "due_date": ["<=", "$date"]}}, "arguments": {"filters": {"company": "Acme Ltd", "docstatus": ["<", 2], "outstanding_amount": [">", 0], "due_date": ["<=", "2026-11-10"]}}, "ok": true},
  {"note": "another operator", "read": {"filters": {"due_date": ["<=", "$date"]}}, "arguments": {"filters": {"due_date": ["like", "2026-11-10"]}}, "ok": false},
  {"note": "a third element", "read": {"filters": {"due_date": ["<=", "$date"]}}, "arguments": {"filters": {"due_date": ["<=", "2026-11-10", "x"]}}, "ok": false},
  {"note": "one element short", "read": {"filters": {"due_date": ["<=", "$date"]}}, "arguments": {"filters": {"due_date": ["2026-11-10"]}}, "ok": false},
  {"note": "a scalar for the list", "read": {"filters": {"due_date": ["<=", "$date"]}}, "arguments": {"filters": {"due_date": "2026-11-10"}}, "ok": false},
  {"note": "a slot value the oracle doesn't hold", "read": {"filters": {"due_date": ["<=", "$date"]}}, "arguments": {"filters": {"due_date": ["<=", "2030-01-01"]}}, "ok": false},
  {"note": "a literal element of another type", "read": {"filters": {"docstatus": ["<", 2]}}, "arguments": {"filters": {"docstatus": ["<", 2.0]}}, "ok": false},
  {"note": "a literal string for a number", "read": {"filters": {"docstatus": ["<", 2]}}, "arguments": {"filters": {"docstatus": ["<", "2"]}}, "ok": false},
  {"note": "true is never 1, at the top as in a list", "read": {"filters": {"docstatus": 1}}, "arguments": {"filters": {"docstatus": true}}, "ok": false},
  {"note": "1.0 is never 1", "read": {"filters": {"docstatus": 1}}, "arguments": {"filters": {"docstatus": 1.0}}, "ok": false},
  {"note": "read 2 with its parties", "read": {"filters": {"supplier": ["in", "$parties"], "posting_date": [">=", "$date"]}}, "arguments": {"filters": {"supplier": ["in", ["Sup A", "Sup B"]], "posting_date": [">=", "2026-11-10"]}}, "ok": true},
  {"note": "a party list the oracle doesn't hold", "read": {"filters": {"supplier": ["in", "$parties"]}}, "arguments": {"filters": {"supplier": ["in", ["Sup C"]]}}, "ok": false},
  {"note": "a single name for the party list", "read": {"filters": {"supplier": ["in", "$parties"]}}, "arguments": {"filters": {"supplier": ["in", "Sup A"]}}, "ok": false},
  {"note": "not in swapped for in", "read": {"filters": {"supplier": ["in", "$parties"]}}, "arguments": {"filters": {"supplier": ["not in", ["Sup A"]]}}, "ok": false},
  {"note": "a literal string beginning with $ is only that string", "read": {"filters": {"status": ["=", "Overdue"]}}, "arguments": {"filters": {"status": ["=", "$company"]}}, "ok": false},
  {"note": "filters as a list of lists", "read": {"filters": {"company": "$company"}}, "arguments": {"filters": [["company", "=", "Acme Ltd"]]}, "ok": false},
  {"note": "fewer top-level fields", "read": {"fields": ["name", "supplier"]}, "arguments": {"fields": ["name"]}, "ok": true},
  {"note": "a top-level field not listed", "read": {"fields": ["name"]}, "arguments": {"fields": ["name", "grand_total"]}, "ok": false},
  {"note": "a nested fields key isn't a subset", "read": {"filters": {"fields": ["=", "x"]}}, "arguments": {"filters": {"fields": ["x"]}}, "ok": false},
  {"note": "a top-level list slot", "read": {"company": "$company", "customers": "$customers"}, "arguments": {"company": "Acme Ltd", "customers": ["Cust A"]}, "ok": true},
  {"note": "a bank line the oracle holds", "read": {"bank_transaction": "$bank_line"}, "arguments": {"bank_transaction": "ACC-BTN-2026-00001"}, "ok": true},
  {"note": "a bank line the oracle doesn't hold", "read": {"bank_transaction": "$bank_line"}, "arguments": {"bank_transaction": "ACC-BTN-2026-00002"}, "ok": false}
,
  {"note": "the mail's attachment as listed", "read": {"doctype": "Purchase Invoice", "name": "$mail_draft", "file": "$mail_file"}, "arguments": {"doctype": "Purchase Invoice", "name": "ACC-PINV-2026-00001", "file": "f1a2b3c4d5"}, "ok": true},
  {"note": "a draft the slot oracle does not hold (ERPNext alone checks that the file is its mail's)", "read": {"doctype": "Purchase Invoice", "name": "$mail_draft", "file": "$mail_file"}, "arguments": {"doctype": "Purchase Invoice", "name": "ACC-PINV-2026-00002", "file": "f1a2b3c4d5"}, "ok": false}
 ]
}
